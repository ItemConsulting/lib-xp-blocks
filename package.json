{
  "name": "@item-enonic-types/lib-blocks",
  "sideEffects": false,
  "description": "Type definitions and styles for lib-xp-blocks",
  "author": "Tom Arild Jakobsen <tajakobsen@gmail.com>",
  "version": "0.5.0",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "tsconfig.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ItemConsulting/lib-xp-blocks.git"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@changesets/cli": "^3.0.3",
    "@enonic-types/global": "^8.0.4",
    "@enonic-types/lib-asset": "^2.0.1",
    "@enonic-types/lib-content": "^8.0.4",
    "@enonic-types/lib-i18n": "^8.0.4",
    "@enonic-types/lib-portal": "^8.0.4",
    "@item-enonic-types/global": "^8.0.0",
    "@item-enonic-types/lib-freemarker": "^4.0.0",
    "@swc/core": "^1.16.2",
    "@types/node": "^26.0.0",
    "concurrently": "^10.0.5",
    "cssnano": "^9.1.0",
    "maplibre-gl": "^6.11.2",
    "postcss": "^8.5.28",
    "postcss-cli": "^12.0.0",
    "postcss-import": "^17.0.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@digdir/designsystemet-css": "^1.23.0",
    "@digdir/designsystemet-web": "^1.23.0",
    "@enonic-types/core": "8.0.4",
    "@itemconsulting/popover-gallery": "^0.4.0"
  },
  "bugs": {
    "url": "https://github.com/ItemConsulting/lib-xp-blocks/issues"
  },
  "homepage": "https://github.com/ItemConsulting/lib-xp-blocks#readme",
  "private": false,
  "browserslist": [
    "baseline widely available"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('build/npm', { recursive: true, force: true })\"",
    "build": "concurrently -c auto -g --timings npm:build:*",
    "build:scripts": "tsdown",
    "build:styles": "postcss src/main/resources/assets/styles/blocks-all.css -d build/npm/assets --base src/main/resources/assets --ext min.css",
    "check": "concurrently -c auto -g --timings npm:check:types npm:lint",
    "check:types": "concurrently --kill-others-on-fail -g -r --timings npm:check:types:*",
    "check:types:assets": "tsc --noEmit -p src/main/resources/assets/tsconfig.json",
    "check:types:server": "tsc --noEmit -p src/main/resources/tsconfig.json",
    "lint": "biome ci",
    "lint:fix": "biome check --write",
    "release": "changeset publish",
    "versioning": "changeset version && npm i --package-lock-only && node .changeset/gradle-version.mjs",
    "prepublishOnly": "npm run prepublish:types && npm run prepublish:generated && npm run prepublish:styles",
    "prepublish:types": "tsc -p src/main/resources/tsconfig.json --declaration --emitDeclarationOnly --declarationDir dist",
    "prepublish:generated": "cp -r .xp-codegen/. dist",
    "prepublish:styles": "node -e \"const fs = require('node:fs'), path = require('node:path'); for (const file of fs.globSync('**/*.css', { cwd: 'src/main/resources' })) fs.cpSync(path.join('src/main/resources', file), path.join('dist', file));\"",
    "postpublish": "rm -r ./dist"
  }
}
